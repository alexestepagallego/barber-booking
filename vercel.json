{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "buildCommand": "npm run db:migrate && npm run build",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "30 2 * * *"
    }
  ]
}
