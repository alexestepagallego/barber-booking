# Copy to .env.local for local development. Every variable is documented in
# docs/deployment.md. Never commit real secrets.

# ── Database ─────────────────────────────────────────────────────────────────
# Defaults match docker-compose.yml, which creates all three databases.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/barber_booking

# Integration and concurrency tests. Its tables are truncated on every run:
# never point it at a database you care about (the name must contain "test").
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/barber_booking_test

# Playwright end-to-end tests (the name must contain "e2e").
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/barber_booking_e2e

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL for links in emails. On Vercel it defaults to the
# production domain (VERCEL_PROJECT_PRODUCTION_URL).
APP_URL=http://localhost:3000

# Secret that derives "manage your booking" links. REQUIRED in production,
# at least 32 characters: openssl rand -base64 48
# Rotating it invalidates every link; then run `npm run tokens:rehash`.
MANAGE_LINK_SECRET=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Without it the
# cron endpoints refuse every request.
CRON_SECRET=

# Customer data (name, email, phone) is erased this many days after an
# appointment. Default 365.
DATA_RETENTION_DAYS=365

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Without a key, emails are saved as HTML files in ./.mail (development) or
# only logged (Vercel).
RESEND_API_KEY=
EMAIL_FROM="Chane Barber <bookings@mail.example.com>"

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────
# Without the secret the check is skipped (development). Test keys that
# always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Public demo ──────────────────────────────────────────────────────────────
# "true" shows the demo banner and credentials, and makes the nightly
# maintenance cron reset ALL data. Never enable it for a real shop.
NEXT_PUBLIC_DEMO_MODE=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
