# Copy to .env.local and adjust. Defaults match docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/barber_booking

# Used by the integration and concurrency tests. Its tables are truncated on every run:
# never point it at a database you care about.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/barber_booking_test

# Used by the Playwright end-to-end tests (truncated and reseeded on every run).
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/barber_booking_e2e
